# Copy to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://hospital_user:CHANGE_ME@localhost:5432/ehms

# Secret used to sign access and refresh tokens. Must be at least 32
# characters - the server refuses to start signing tokens otherwise.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# bcrypt cost factor for password hashing
BCRYPT_ROUNDS=12

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Failed login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10

# Number of reverse proxies in front of the API (nginx = 1)
TRUST_PROXY_HOPS=1

NODE_ENV=development
